# Profound IQ Consulting - Environment Configuration
# Copy this file to .env and fill in your actual values

# ==============================================================================
# DATABASE
# ==============================================================================
# MySQL connection URL for Drizzle ORM
# Format: mysql://username:password@host:port/database
DATABASE_URL=mysql://root:password@localhost:3306/profound_iq

# ==============================================================================
# SESSION & AUTHENTICATION
# ==============================================================================
# Secret key for signing JWT session tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-long-random-secret-key-here

# Email address of the initial admin account
# This user will be created as an admin during first signup if their email matches this
ADMIN_EMAIL=admin@profoundiq.com

# ==============================================================================
# SERVER
# ==============================================================================
# Server port (default: 3000)
PORT=3000

# Public application address used in payment callbacks, emails, and share links.
PUBLIC_SITE_ORIGIN=http://localhost:3000

# Environment: development or production
NODE_ENV=development

# ==============================================================================
# DIGITALOCEAN SPACES (S3-Compatible Storage)
# ==============================================================================
# DO Spaces endpoint URL
# Example: https://nyc3.digitaloceanspaces.com
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com

# DO Spaces region
# Common values: nyc3, sfo3, ams3, sgp1
DO_SPACES_REGION=nyc3

# DO Spaces bucket name
DO_SPACES_BUCKET=your-bucket-name

# DO Spaces access key (from Applications & API)
DO_SPACES_ACCESS_KEY=your-access-key

# DO Spaces secret key (from Applications & API)
DO_SPACES_SECRET_KEY=your-secret-key

# Base URL for public access to DO Spaces files
# Leave empty to auto-construct from bucket and region
# Example: https://your-bucket-name.nyc3.digitaloceanspaces.com
DO_SPACES_BASE_URL=https://your-bucket-name.nyc3.digitaloceanspaces.com

# ==============================================================================
# PAYMENT PROCESSING (Paystack)
# ==============================================================================
# Paystack test or live secret key
# Get from: https://dashboard.paystack.com
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# Optional Paystack publishable key. Required only for a future client-side
# Paystack integration; the current checkout flow initializes server-side.
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# ==============================================================================
# EMAIL DELIVERY (Resend)
# ==============================================================================
# Resend API key for sending emails
# Get from: https://resend.com
RESEND_API_KEY=re_your_resend_api_key

# Email address to use as the "From" address
# Example: noreply@profoundiq.com
EMAIL_FROM=noreply@profoundiq.com

# ==============================================================================
# OPTIONAL: VITE BUILD
# ==============================================================================
# App ID (used by client-side code)
VITE_APP_ID=profound-iq-consulting

# ==============================================================================
# Notes:
# ==============================================================================
# - After setting DATABASE_URL, run: pnpm db:push
# - SESSION_SECRET must be a long random string (minimum 32 bytes recommended)
# - DO_SPACES_ENDPOINT, _REGION, _BUCKET, _ACCESS_KEY, _SECRET_KEY are required for file uploads
# - PAYSTACK_SECRET_KEY is required for payment processing
# - RESEND_API_KEY is required for sending emails (password resets, notifications, etc.)
# - For development, you can use Paystack test keys with test card numbers
# - In production, ensure all secrets are stored securely (use your hosting provider's secret management)
